# --- DISCORD BASICS ---
DISCORD_BOT_TOKEN="your_token_here"
DISCORD_CHANNEL_ID="123456789012345678"

# --- MODE A: STATUSPAGE (Plug & Play) ---
# Can be the full /status/<slug> URL or a direct status page URL behind a reverse proxy.
KUMA_STATUSPAGE_URL="https://uptime.example.com/status/example"

# --- MODE B: DIRECT API (Optional, overrides Mode A if complete) ---
# Base URL to the Uptime Kuma UI (e.g., https://host or https://host/kuma)
# Note: Metrics API does not provide custom ordering or groups. Monitors are sorted by name.
# For custom ordering/groups, use Statuspage mode.
KUMA_API_URL=""
KUMA_API_KEY=""

# --- BOT SETTINGS ---
# Minimum 30 seconds, maximum 86400 seconds.
REFRESH_INTERVAL=30
# Local: ./data | Docker: /app/data (volume-mounted in docker-compose)
DATA_DIR="./data"
BUTTON_URL=""
